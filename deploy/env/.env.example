# Copy to a deployment-only environment file and replace every __SET_IN_ENV__ value.
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://api.invalid
ADMIN_ALLOWED_ORIGINS=https://admin.invalid

POSTGRES_DB=shop_mall
POSTGRES_USER=shop_mall
POSTGRES_PASSWORD=__SET_IN_ENV__
POSTGRES_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

BUYER_JWT_ISSUER=__SET_IN_ENV__
BUYER_JWT_AUDIENCE=__SET_IN_ENV__
BUYER_JWT_ACTIVE_KID=__SET_IN_ENV__
BUYER_JWT_KEYRING=__SET_IN_ENV_WITH_BASE64_JSON__
BUYER_JWT_TTL=24h
ADMIN_JWT_ISSUER=__SET_IN_ENV__
ADMIN_JWT_AUDIENCE=__SET_IN_ENV__
ADMIN_JWT_ACTIVE_KID=__SET_IN_ENV__
ADMIN_JWT_KEYRING=__SET_IN_ENV_WITH_BASE64_JSON__
ADMIN_JWT_TTL=30m

UPLOAD_MAX_BYTES=2097152
SIGNUP_BONUS_POINTS=100

# WeChat code2session integration for buyer login (wx-login). All three must be
# set together; leave all empty to run with the deterministic local fake client.
WECHAT_APP_ID=__SET_IN_ENV__
WECHAT_APP_SECRET=__SET_IN_ENV__
WECHAT_ENDPOINT=https://api.weixin.qq.com/sns/jscode2session
IMAGE_MAX_PIXELS=25000000
IMAGE_STORAGE_CAPACITY_BYTES=10737418240
IMAGE_GRACE_PERIOD=24h
IMAGE_CLEANUP_INTERVAL=1h
IMAGE_VOLUME_DIR=/var/lib/shop-mall/images
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CERT_DIR=__SET_IN_ENV_WITH_CERT_DIRECTORY__
APP_IMAGE=__SET_IN_ENV_WITH_IMMUTABLE_IMAGE_TAG__
